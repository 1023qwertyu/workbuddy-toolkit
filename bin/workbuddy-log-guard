#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import os
import sys
import json
import re
import time
import shutil
import subprocess
from datetime import datetime

import socket

HOME = os.path.expanduser("~")
LOG_DIR = os.environ.get("WB_LOG_DIR", os.path.join(HOME, ".workbuddy", "logs"))
SANDBOX_DIR = os.path.join(LOG_DIR, "sandbox")
TRACES_DIR = os.environ.get("WB_TRACES_DIR", os.path.join(HOME, ".workbuddy", "traces"))
SESSIONS_DIR = os.environ.get("WB_SESSIONS_DIR", os.path.join(HOME, ".workbuddy", "workspace", "sessions"))
SHELL_SNAPSHOTS_DIR = os.environ.get("WB_SHELL_SNAPSHOTS_DIR", os.path.join(HOME, ".workbuddy", "shell-snapshots"))
CONFIG_FILE = os.environ.get("WB_LOG_GUARD_CONFIG", os.path.join(HOME, ".workbuddy", "log_guard.json"))

def load_config():
    # Defaults
    config = {
        "ttl_minutes": 2160,       # 36 hours
        "max_sandbox_mb": 2048,    # 2GB hard limit
        "target_sandbox_mb": 1536, # 1.5GB target limit when cleaning
        "max_file_mb": 30,         # Single file max 30MB
        "sessions_ttl_hours": 72,   # 3 days
        "max_sessions_keep": 10,    # Max active sessions to retain
        "heal_seatbelt_rules": True, # Auto-inject temp rules into sandbox-center
        "reap_orphaned_daemons": True, # Clean up orphaned daemons when GUI is closed
        "clean_runaway_temp_logs": True, # Truncate actively-written runaway logs in /tmp
        "max_temp_file_mb": 500,     # Runaway temp log max 500MB
        "bundle_migration_ttl_hours": 72 # Stale bundle migration TTL 72 hours
    }
    # Env var overrides
    if "WB_TTL_MINUTES" in os.environ:
        config["ttl_minutes"] = int(os.environ["WB_TTL_MINUTES"])
    if "WB_MAX_SANDBOX_MB" in os.environ:
        config["max_sandbox_mb"] = int(os.environ["WB_MAX_SANDBOX_MB"])
    if "WB_TARGET_SANDBOX_MB" in os.environ:
        config["target_sandbox_mb"] = int(os.environ["WB_TARGET_SANDBOX_MB"])
    if "WB_MAX_FILE_MB" in os.environ:
        config["max_file_mb"] = int(os.environ["WB_MAX_FILE_MB"])
    if "WB_SESSIONS_TTL_HOURS" in os.environ:
        config["sessions_ttl_hours"] = int(os.environ["WB_SESSIONS_TTL_HOURS"])
    if "WB_MAX_SESSIONS_KEEP" in os.environ:
        config["max_sessions_keep"] = int(os.environ["WB_MAX_SESSIONS_KEEP"])
    if "WB_HEAL_SEATBELT_RULES" in os.environ:
        config["heal_seatbelt_rules"] = os.environ["WB_HEAL_SEATBELT_RULES"].lower() in ("1", "true", "yes")
    if "WB_REAP_ORPHANED_DAEMONS" in os.environ:
        config["reap_orphaned_daemons"] = os.environ["WB_REAP_ORPHANED_DAEMONS"].lower() in ("1", "true", "yes")
    if "WB_CLEAN_RUNAWAY_TEMP_LOGS" in os.environ:
        config["clean_runaway_temp_logs"] = os.environ["WB_CLEAN_RUNAWAY_TEMP_LOGS"].lower() in ("1", "true", "yes")
    if "WB_MAX_TEMP_FILE_MB" in os.environ:
        config["max_temp_file_mb"] = float(os.environ["WB_MAX_TEMP_FILE_MB"])
    if "WB_BUNDLE_MIGRATION_TTL_HOURS" in os.environ:
        config["bundle_migration_ttl_hours"] = int(os.environ["WB_BUNDLE_MIGRATION_TTL_HOURS"])


    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                file_cfg = json.load(f)
                for k in config.keys():
                    if k in file_cfg:
                        config[k] = file_cfg[k]
        except Exception as e:
            print(f"Failed to read {CONFIG_FILE}: {e}", file=sys.stderr)
            
    return config

def get_open_files(directory):
    open_files = set()
    if not os.path.exists(directory) or os.name == 'nt':
        return open_files
    try:
        # lsof +D <dir> is recursive, -F n outputs file paths
        result = subprocess.run(["lsof", "-F", "n", "+D", os.path.realpath(directory)], 
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=15, close_fds=True)
        for line in result.stdout.splitlines():
            if line.startswith('n/'):
                open_files.add(os.path.realpath(line[1:]))
    except Exception:
        pass
    return open_files

def truncate_file(filepath):
    try:
        with open(filepath, 'w'):
            pass  # Truncate to 0
        return True
    except Exception:
        return False

def remove_file(filepath):
    try:
        os.remove(filepath)
        return True
    except Exception:
        return False

def is_file_open(filepath, open_files_set):
    real_fp = os.path.realpath(filepath)
    if real_fp in open_files_set:
        return True
    
    if os.name == 'nt':
        try:
            # On Windows, try to rename it. If it's opened by another process, it will raise PermissionError or Sharing Violation.
            tmp = filepath + ".wblck"
            os.rename(filepath, tmp)
            os.rename(tmp, filepath)
            return False
        except OSError as e:
            if getattr(e, 'winerror', None) == 32 or getattr(e, 'winerror', None) == 33 or e.errno == 13:
                return True
            return False
    return False

def get_dir_size(directory):
    total = 0
    for dirpath, _, filenames in os.walk(directory):
        for f in filenames:
            fp = os.path.join(dirpath, f)
            if not os.path.islink(fp) and os.path.isfile(fp):
                total += os.path.getsize(fp)
    return total

def clean_session_snapshots(sessions_dir, open_files_set=None, ttl_hours=72, max_keep=10):
    """
    Surgically cleans up old WorkBuddy session snapshots and modify backups.
    Protects active sessions, open files, and recent sessions (< ttl_hours).
    """
    if not os.path.exists(sessions_dir):
        return 0, 0
    now = time.time()
    ttl_seconds = ttl_hours * 3600
    cleaned_sessions = 0
    freed_bytes = 0

    if open_files_set is None:
        open_files = get_open_files(sessions_dir)
    else:
        open_files = set(open_files_set)
        if os.path.exists(sessions_dir):
            open_files.update(get_open_files(sessions_dir))

    sessions = []
    try:
        entries = os.listdir(sessions_dir)
    except Exception:
        return 0, 0

    for item in entries:
        sp = os.path.join(sessions_dir, item)
        if os.path.isdir(sp):
            try:
                st = os.stat(sp)
                sessions.append((st.st_mtime, sp, item))
            except Exception:
                pass

    # Sort descending: newest sessions first
    sessions.sort(key=lambda x: x[0], reverse=True)

    for idx, (mtime, sp, _item) in enumerate(sessions):
        # Keep the most recent active sessions unless older than TTL
        is_older_than_ttl = (now - mtime) > ttl_seconds
        exceeds_keep = (idx >= max_keep)

        if not (is_older_than_ttl or exceeds_keep):
            continue

        # Check if session lockfile or any files inside session are open
        real_sp = os.path.realpath(sp)
        lock_file = os.path.join(sp, "center.backup.lock")
        is_locked = (os.path.exists(lock_file) and is_file_open(lock_file, open_files))
        has_open_files = any(f.startswith(real_sp + os.sep) for f in open_files)
        if is_locked or has_open_files:
            continue

        # Targeted surgical deletion of snapshot artifacts only
        for target_subdir in ["modify_backup", ".modify_backup_meta", "snapfile"]:
            target_path = os.path.join(sp, target_subdir)
            if os.path.exists(target_path):
                try:
                    freed_bytes += get_dir_size(target_path)
                    shutil.rmtree(target_path, ignore_errors=True)
                except Exception:
                    pass

        # If session is old (> ttl) and essentially empty, clean up directory
        if is_older_than_ttl:
            try:
                remaining = [f for f in os.listdir(sp) if f != "center.backup.lock"]
                if not remaining:
                    shutil.rmtree(sp, ignore_errors=True)
                    cleaned_sessions += 1
            except Exception:
                pass

    return cleaned_sessions, freed_bytes

def clean_shell_snapshots(snapshots_dir, ttl_hours=72):
    """
    Cleans up stale shell snapshot bundles.
    """
    if not os.path.exists(snapshots_dir):
        return 0
    now = time.time()
    ttl_seconds = ttl_hours * 3600
    cleaned = 0
    for root, _, filenames in os.walk(snapshots_dir):
        for f in filenames:
            fp = os.path.join(root, f)
            try:
                if now - os.path.getmtime(fp) > ttl_seconds:
                    if remove_file(fp):
                        cleaned += 1
            except Exception:
                pass
    return cleaned

def _is_open_by_any_process(filepath):
    """判断文件当前是否被任意进程打开（失控日志的必要条件：仍有进程在持续写入）。

    Linux 直接扫描 /proc/<pid>/fd；其他 POSIX 平台使用 lsof。无法判断时返回 False（宁可不动）。
    """
    real = os.path.realpath(filepath)
    if os.path.isdir("/proc/self/fd"):
        try:
            pids = [e for e in os.listdir("/proc") if e.isdigit()]
        except OSError:
            pids = []
        for pid in pids:
            fd_dir = os.path.join("/proc", pid, "fd")
            try:
                fds = os.listdir(fd_dir)
            except OSError:
                continue
            for fd in fds:
                try:
                    if os.readlink(os.path.join(fd_dir, fd)) == real:
                        return True
                except OSError:
                    continue
        return False
    if shutil.which("lsof"):
        try:
            res = subprocess.run(["lsof", "-t", "--", real], stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, text=True, timeout=10, close_fds=True)
            return bool(res.stdout.strip())
        except Exception:
            return False
    return False

def clean_runaway_temp_logs(temp_dirs=None, max_temp_file_mb=500, log_extensions=(".log", ".txt", ".out", ".err"),
                            active_window_minutes=15):
    """
    Surgically truncates *runaway* log files in temporary directories (e.g. /tmp, /private/tmp).

    A file is only treated as runaway when ALL of the following hold:
    - regular file (not a symlink) owned by the current user, directly inside a temp dir;
    - its file extension is a log-like extension (suffix match only, e.g. ``t-fail.log``);
    - it exceeds ``max_temp_file_mb``;
    - it was modified within the last ``active_window_minutes`` and is still held open by a
      process (POSIX), i.e. something is actively writing it.

    Large files at rest (datasets, archives, databases, finished logs) are never touched:
    they cannot grow on their own, and truncating them would silently destroy user data.
    Applies truncate_file() in-place so active writers keep a valid descriptor.
    Windows: "held open" is detected via a sharing violation on rename; if the writer holds an
    exclusive lock the truncate attempt simply fails and the file is skipped.
    """
    if temp_dirs is None:
        dirs_to_check = []
        if "WB_TMP_DIR" in os.environ:
            dirs_to_check.append(os.environ["WB_TMP_DIR"])
        import tempfile
        sys_tmp = tempfile.gettempdir()
        if sys_tmp and sys_tmp not in dirs_to_check:
            dirs_to_check.append(sys_tmp)
        for standard_tmp in ["/tmp", "/private/tmp"]:
            if os.path.exists(standard_tmp) and standard_tmp not in dirs_to_check:
                dirs_to_check.append(standard_tmp)
    else:
        dirs_to_check = list(temp_dirs)

    cleaned_count = 0
    freed_bytes = 0
    max_bytes = int(max_temp_file_mb * 1024 * 1024)
    active_window_seconds = max(0, active_window_minutes) * 60
    current_uid = os.getuid() if hasattr(os, "getuid") else None
    now = time.time()

    # Track already scanned paths to prevent duplicate processing if /tmp -> /private/tmp symlink
    scanned_realpaths = set()

    for t_dir in dirs_to_check:
        if not os.path.exists(t_dir) or not os.path.isdir(t_dir):
            continue
        try:
            entries = os.listdir(t_dir)
        except Exception:
            continue

        for item in entries:
            fp = os.path.join(t_dir, item)
            # Must be a regular file, skip directories and symlinks
            if not os.path.isfile(fp) or os.path.islink(fp):
                continue

            real_fp = os.path.realpath(fp)
            if real_fp in scanned_realpaths:
                continue
            scanned_realpaths.add(real_fp)

            # 只认真正的日志后缀；不再做"文件名任意位置含 -err/-crash"的子串匹配
            # （那会命中 dataset-errata.tar.gz、my-crash-dump.sqlite 之类的用户数据）
            if os.path.splitext(item.lower())[1] not in log_extensions:
                continue

            try:
                st = os.stat(fp)
                # Ensure ownership: only clean files owned by current user
                if current_uid is not None and st.st_uid != current_uid:
                    continue
                if st.st_size <= max_bytes:
                    continue
                if now - st.st_mtime > active_window_seconds:
                    continue  # 已停止增长的大文件不是"失控"日志

                if os.name == 'nt':
                    # Windows 上"仍被进程打开"表现为无法重命名（共享冲突）；没人持有的文件是静止的
                    if not is_file_open(fp, set()):
                        continue
                elif not _is_open_by_any_process(fp):
                    continue  # 没有进程在写，它不会再增长

                original_size = st.st_size
                if truncate_file(fp):
                    freed_bytes += original_size
                    cleaned_count += 1
                    print(f"[LOG_GUARD] Truncated runaway temp log: {fp} ({original_size / (1024*1024):.1f} MB)", file=sys.stderr)
            except Exception:
                pass

    return cleaned_count, freed_bytes


def clean_bundle_migration_cache(bundle_migration_dir=None, ttl_hours=72):
    """
    Cleans up stale WorkBuddy bundle update backups and downloads in ~/Library/Caches/com.tencent.workbuddy.mac.BundleMigration.
    Only removes items older than ttl_hours (default: 72h / 3 days) to prevent disk exhaustion.
    """
    if bundle_migration_dir is None:
        bm_dir = os.path.expanduser("~/Library/Caches/com.tencent.workbuddy.mac.BundleMigration")
    else:
        bm_dir = bundle_migration_dir

    if not os.path.exists(bm_dir):
        return 0, 0

    now = time.time()
    ttl_seconds = ttl_hours * 3600
    cleaned_count = 0
    freed_bytes = 0

    # Subdirectories that store large binaries: backups, downloads, extracted
    subdirs = ["backups", "downloads", "extracted"]
    for sub in subdirs:
        sub_path = os.path.join(bm_dir, sub)
        if not os.path.exists(sub_path):
            continue
        try:
            items = os.listdir(sub_path)
        except Exception:
            continue

        for item in items:
            item_path = os.path.join(sub_path, item)
            try:
                mtime = os.path.getmtime(item_path)
                if now - mtime > ttl_seconds:
                    if os.path.isdir(item_path):
                        sz = get_dir_size(item_path)
                        shutil.rmtree(item_path, ignore_errors=True)
                        freed_bytes += sz
                        cleaned_count += 1
                    elif os.path.isfile(item_path):
                        sz = os.path.getsize(item_path)
                        if remove_file(item_path):
                            freed_bytes += sz
                            cleaned_count += 1
            except Exception:
                pass

    return cleaned_count, freed_bytes

def find_sandbox_center_socket(socket_dir=None):

    """
    Locates active sandbox-center Unix domain socket.
    """
    if os.name == 'nt':
        return None
    search_dir = socket_dir or "/tmp"
    if not os.path.exists(search_dir):
        return None
    candidates = []
    try:
        for f in os.listdir(search_dir):
            if f.startswith("workbuddy-sandbox-center-") and f.endswith(".sock"):
                fp = os.path.join(search_dir, f)
                try:
                    st = os.stat(fp)
                    candidates.append((st.st_mtime, fp))
                except Exception:
                    pass
    except Exception:
        pass
    if not candidates:
        return None
    candidates.sort(key=lambda x: x[0], reverse=True)
    return candidates[0][1]

MAX_IPC_PAYLOAD = 4 * 1024 * 1024  # 4MB 硬上限，超限熔断

_LAST_IPC_DIAG = {"status": "ok", "error_code": None, "detail": None}

def get_last_ipc_diag():
    """返回最近一次 send_sandbox_ipc 的白盒诊断信息 (防止 fail-open 吞没现场异常)。"""
    return dict(_LAST_IPC_DIAG)

def send_sandbox_ipc_with_diag(socket_path, command, data, uid="default", timeout=2.0, session_id=None):
    """
    底层 IPC 发送逻辑，返回 (response_dict, diag_dict)。
    diag_dict 包含详细物理状态，解决 FAIL_OPEN_HIDES_DIAGNOSTIC 问题。
    """
    global _LAST_IPC_DIAG
    if not socket_path or not os.path.exists(socket_path):
        diag = {"status": "error", "error_code": "SOCKET_NOT_FOUND", "detail": f"Socket missing: {socket_path}"}
        _LAST_IPC_DIAG = diag
        return None, diag
    if os.name == 'nt':
        diag = {"status": "error", "error_code": "UNSUPPORTED_PLATFORM", "detail": "Unix socket unsupported on Windows"}
        _LAST_IPC_DIAG = diag
        return None, diag

    # Wire protocol: sessionId 在顶层 envelope 必须与 data 分离
    sid = session_id or (data.get("sessionId") if isinstance(data, dict) else None)
    req_data = {k: v for k, v in data.items() if k != "sessionId"} if isinstance(data, dict) else {}

    req = {
        "messageId": f"wb-guard:{int(time.time()*1000)}",
        "command": command,
        "uid": uid,
        "data": {
            **req_data,
            "_client": {"role": "agent-cli", "pid": os.getpid()}
        }
    }
    if sid:
        req["sessionId"] = str(sid)

    try:
        payload = json.dumps(req).encode("utf-8") + b"\n"
    except Exception as e:
        diag = {"status": "error", "error_code": "SERIALIZATION_FAILED", "detail": str(e)}
        _LAST_IPC_DIAG = diag
        return None, diag

    if len(payload) > MAX_IPC_PAYLOAD:
        diag = {"status": "error", "error_code": "PAYLOAD_OVERFLOW", "detail": f"Payload size {len(payload)} > max {MAX_IPC_PAYLOAD}"}
        _LAST_IPC_DIAG = diag
        return None, diag

    end_time = time.monotonic() + timeout
    s = None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(socket_path)
        s.sendall(payload)

        res = b""
        while True:
            remain = end_time - time.monotonic()
            if remain <= 0:
                diag = {"status": "error", "error_code": "DEADLINE_EXCEEDED", "detail": f"Monotonic deadline ({timeout}s) exceeded"}
                _LAST_IPC_DIAG = diag
                return None, diag
            s.settimeout(min(remain, 0.5))
            try:
                chunk = s.recv(65536)
            except (socket.timeout, BlockingIOError):
                continue
            if not chunk:
                break
            res += chunk
            if len(res) > MAX_IPC_PAYLOAD:
                diag = {"status": "error", "error_code": "RESPONSE_OVERFLOW", "detail": f"Response size {len(res)} > max {MAX_IPC_PAYLOAD}"}
                _LAST_IPC_DIAG = diag
                return None, diag
            stripped = res.strip()
            if stripped.startswith(b"{") and stripped.endswith(b"}"):
                try:
                    parsed = json.loads(stripped.decode("utf-8"))
                    diag = {"status": "ok", "error_code": None, "bytes": len(res)}
                    _LAST_IPC_DIAG = diag
                    return parsed, diag
                except Exception:
                    pass
        if res.strip():
            try:
                parsed = json.loads(res.decode("utf-8"))
                diag = {"status": "ok", "error_code": None, "bytes": len(res)}
                _LAST_IPC_DIAG = diag
                return parsed, diag
            except Exception as e:
                diag = {"status": "error", "error_code": "MALFORMED_JSON", "detail": str(e)}
                _LAST_IPC_DIAG = diag
                return None, diag
        diag = {"status": "error", "error_code": "EMPTY_RESPONSE", "detail": "Server closed connection without data"}
        _LAST_IPC_DIAG = diag
        return None, diag
    except socket.timeout:
        diag = {"status": "error", "error_code": "DEADLINE_EXCEEDED", "detail": f"Socket timeout after {timeout}s"}
        _LAST_IPC_DIAG = diag
        return None, diag
    except ConnectionRefusedError:
        diag = {"status": "error", "error_code": "CONNECTION_REFUSED", "detail": "Connection refused by daemon socket"}
        _LAST_IPC_DIAG = diag
        return None, diag
    except Exception as e:
        diag = {"status": "error", "error_code": "SOCKET_EXCEPTION", "detail": f"{type(e).__name__}: {str(e)}"}
        _LAST_IPC_DIAG = diag
        return None, diag
    finally:
        if s is not None:
            try:
                s.close()
            except Exception:
                pass

def send_sandbox_ipc(socket_path, command, data, uid="default", timeout=2.0, session_id=None):
    """
    Sends a structured IPC request to sandbox-center and returns parsed JSON.
    Protected with overall monotonic deadline and 4MB max payload limits (Fail-Open for execution).
    Preserves diagnostic root-cause in get_last_ipc_diag().
    """
    resp, _ = send_sandbox_ipc_with_diag(socket_path, command, data, uid=uid, timeout=timeout, session_id=session_id)
    return resp

def find_active_uid():
    """Locates active WorkBuddy user UID from desktop auth info or profiles."""
    if sys.platform == "darwin":
        candidates = [
            os.path.expanduser("~/Library/Application Support/CodeBuddyExtension/Data/Public/auth/workbuddy-desktop.info"),
            os.path.expanduser("~/.workbuddy/auth/workbuddy-desktop.info"),
        ]
    elif sys.platform == "win32":
        appdata = os.environ.get("APPDATA", os.path.expanduser("~\\AppData\\Roaming"))
        localappdata = os.environ.get("LOCALAPPDATA", os.path.expanduser("~\\AppData\\Local"))
        userprofile = os.environ.get("USERPROFILE", os.path.expanduser("~"))
        candidates = [
            os.path.join(appdata, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.join(localappdata, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.join(userprofile, ".workbuddy", "auth", "workbuddy-desktop.info"),
        ]
    else:  # Linux & others
        config_home = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
        data_home = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
        candidates = [
            os.path.join(config_home, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.join(data_home, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
            os.path.expanduser("~/.workbuddy/auth/workbuddy-desktop.info"),
        ]
    for af in candidates:
        if os.path.exists(af):
            try:
                with open(af, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    uid = data.get("account", {}).get("uid") or data.get("uid")
                    if uid:
                        return uid
            except Exception:
                pass
    profiles_dir = os.path.expanduser("~/.workbuddy/auth_profiles")
    if os.path.exists(profiles_dir):
        for f in os.listdir(profiles_dir):
            if f.endswith(".info"):
                try:
                    with open(os.path.join(profiles_dir, f), "r", encoding="utf-8") as pf:
                        data = json.load(pf)
                        uid = data.get("account", {}).get("uid") or data.get("uid")
                        if uid:
                            return uid
                except Exception:
                    pass
    return "default"

def _acquire_file_lock(lock_path, timeout=5.0):
    """跨平台轻量文件锁，确保多 Agent 并发时不发生 heal 竞态与规则撕裂。"""
    try:
        os.makedirs(os.path.dirname(os.path.abspath(lock_path)), exist_ok=True)
        fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    except OSError:
        return None
    end = time.monotonic() + timeout
    if sys.platform == "win32":
        import msvcrt
        while True:
            try:
                msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)
                return fd
            except OSError:
                if time.monotonic() >= end:
                    try:
                        os.close(fd)
                    except Exception:
                        pass
                    return None
                time.sleep(0.05)
    else:
        import fcntl
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return fd
            except OSError:
                if time.monotonic() >= end:
                    try:
                        os.close(fd)
                    except Exception:
                        pass
                    return None
                time.sleep(0.05)

def _release_file_lock(fd):
    """安全释放跨平台文件锁并关闭句柄。"""
    if fd is None:
        return
    try:
        if sys.platform == "win32":
            import msvcrt
            try:
                os.lseek(fd, 0, os.SEEK_SET)
                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
            except OSError:
                pass
        else:
            import fcntl
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            except OSError:
                pass
    finally:
        try:
            os.close(fd)
        except Exception:
            pass

def heal_sandbox_center_rules(socket_path=None, uid=None, session_id=None):
    """
    Ensures macOS/Linux temp wildcard rules are active in sandbox-center
    and prunes bloated auto_grant rules across global and active sessions
    to prevent SBPL compilation lockup and supervisor 120s timeouts.
    Guarded by cross-process single-flight lock and post-injection readback verification.
    """
    target_uid = uid or find_active_uid()
    sock = socket_path or find_sandbox_center_socket()
    if not sock:
        return {"status": "no_socket", "diag": get_last_ipc_diag()}

    lock_path = os.environ.get("WORKBUDDY_HEAL_LOCK") or os.path.expanduser("~/.workbuddy/cache/heal.lock")
    lock_fd = _acquire_file_lock(lock_path, timeout=5.0)
    if lock_fd is None:
        return {"status": "locked_skip", "diag": {"status": "locked", "detail": "Concurrent heal in progress"}}

    try:
        # 1. Probe current global rules
        rules_resp = send_sandbox_ipc(sock, "sandbox.rules.get_rules", {}, uid=target_uid)
        if not rules_resp or not rules_resp.get("success"):
            return {"status": "unresponsive", "diag": get_last_ipc_diag()}

        existing_rules = rules_resp.get("data", {}).get("fileRules", [])
        existing_paths = {r.get("path") for r in existing_rules if isinstance(r, dict)}

        temp_paths = [
            "/var/folders/**",
            "/private/var/folders/**",
            "/tmp/**",
            "/private/tmp/**",
            "/var/tmp/**",
            "/private/var/tmp/**"
        ]
        missing = [p for p in temp_paths if p not in existing_paths]

        added_count = 0
        if missing:
            to_add = [{"path": p, "action": "read=allow|write=allow|delete=allow", "isDirectory": True} for p in missing]
            add_resp = send_sandbox_ipc(sock, "sandbox.rules.add_file_rule", {"category": "global", "rules": to_add}, uid=target_uid)
            if add_resp and add_resp.get("success"):
                added_count = len(missing)

        # 2. Prune auto_grant rules:
        # 2a. Global category pruning (if legacy global auto_grant bloated)
        cleared_auto_grant = False
        pruned_sessions = []
        if len(existing_rules) > 500:
            send_sandbox_ipc(sock, "sandbox.rules.set_file_rules", {"category": "auto_grant", "rules": []}, uid=target_uid)
            send_sandbox_ipc(sock, "sandbox.rules.set_file_rules", {"category": "temp", "rules": []}, uid=target_uid)
            cleared_auto_grant = True

        # 2b. Active Sessions auto_grant pruning (Per-Session Rule Explosion Mitigator)
        session_ids = set()
        if session_id:
            session_ids.add(str(session_id))
        else:
            mon_resp = send_sandbox_ipc(sock, "sandbox.monitor.query", {}, uid=target_uid, timeout=3.0)
            if mon_resp and mon_resp.get("success"):
                buckets = mon_resp.get("data", {}).get("decideBucketsTop", [])
                for b in buckets:
                    sid = b.get("sessionId")
                    if sid:
                        session_ids.add(str(sid))
            # Also check session workspace folders
            sessions_dir = os.path.expanduser("~/.workbuddy/workspace/sessions")
            if os.path.isdir(sessions_dir):
                try:
                    for d in os.listdir(sessions_dir):
                        if len(d) >= 32 and "-" in d:
                            session_ids.add(d)
                except Exception:
                    pass

        for sid in session_ids:
            s_resp = send_sandbox_ipc(sock, "sandbox.rules.get_rules", {"sessionId": sid}, uid=target_uid, session_id=sid, timeout=3.0)
            if s_resp and s_resp.get("success"):
                s_rules = s_resp.get("data", {}).get("fileRules", [])
                auto_grant_count = sum(1 for r in s_rules if r.get("category") == "auto_grant")
                temp_count = sum(1 for r in s_rules if r.get("category") == "temp")
                if auto_grant_count > 500 or (auto_grant_count + temp_count) > 500 or len(s_rules) > 1000:
                    del_ag = send_sandbox_ipc(sock, "sandbox.rules.set_file_rules", {"category": "auto_grant", "rules": []}, uid=target_uid, session_id=sid, timeout=5.0)
                    del_tmp = send_sandbox_ipc(sock, "sandbox.rules.set_file_rules", {"category": "temp", "rules": []}, uid=target_uid, session_id=sid, timeout=5.0)
                    cleared_auto_grant = True
                    pruned_sessions.append({
                        "sessionId": sid,
                        "pruned_rules": auto_grant_count + temp_count,
                        "success": bool(del_ag and del_ag.get("success") and del_tmp and del_tmp.get("success"))
                    })

        # 3. Readback verification (锁内回读校验与断言)
        verified = True
        total_rules = len(existing_rules) + added_count
        verify_resp = send_sandbox_ipc(sock, "sandbox.rules.get_rules", {}, uid=target_uid)
        if verify_resp and verify_resp.get("success"):
            v_rules = verify_resp.get("data", {}).get("fileRules", [])
            if v_rules:
                v_paths = {r.get("path") for r in v_rules if isinstance(r, dict)}
                verified = any(p in v_paths for p in temp_paths) or (len(v_rules) >= len(existing_rules))
                total_rules = max(total_rules, len(v_rules))

        return {
            "status": "ok",
            "total_rules": total_rules,
            "added_temp_rules": added_count,
            "cleared_auto_grant": cleared_auto_grant,
            "pruned_sessions": pruned_sessions,
            "verified": verified
        }
    finally:
        _release_file_lock(lock_fd)

def is_workbuddy_gui_running():
    """
    Checks if WorkBuddy desktop GUI application is actively running across platforms.
    Prioritizes zero-fork macOS libproc FFI, /proc filesystem read on Linux, and tasklist on Windows.
    """
    if sys.platform == "darwin":
        try:
            import ctypes
            libproc = ctypes.CDLL("libproc.dylib")
            needed = libproc.proc_listpids(1, 0, None, 0)
            num_slots = max(2048, (needed // ctypes.sizeof(ctypes.c_int)) + 128) if needed > 0 else 2048
            pids = (ctypes.c_int * num_slots)()
            bytes_ret = libproc.proc_listpids(1, 0, pids, ctypes.sizeof(pids))
            num_pids = bytes_ret // ctypes.sizeof(ctypes.c_int)
            buf = ctypes.create_string_buffer(1024)
            for i in range(num_pids):
                pid = pids[i]
                if pid <= 0:
                    continue
                if libproc.proc_pidpath(pid, buf, 1024) > 0:
                    p = buf.value.decode("utf-8", errors="ignore")
                    if "WorkBuddy.app/Contents/MacOS" in p and "Helper" not in p and "crashpad" not in p:
                        return True
            return False
        except Exception:
            pass
        # Fallback for Darwin if libproc fails
        try:
            res = subprocess.run(["pgrep", "-f", r"WorkBuddy\.app/Contents/MacOS/(Electron|WorkBuddy)"],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5, close_fds=True)
            if res.stdout.strip():
                return True
            res2 = subprocess.run(["pgrep", "-f", "WorkBuddy.app/Contents/MacOS"],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5, close_fds=True)
            return bool(res2.stdout.strip())
        except Exception:
            return False
    elif sys.platform == "win32":
        try:
            res = subprocess.run(["tasklist", "/fi", "IMAGENAME eq WorkBuddy.exe"],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5, close_fds=True)
            return "WorkBuddy.exe" in (res.stdout or "")
        except Exception:
            return False
    else:  # Linux: read /proc directly without fork
        try:
            for entry in os.listdir("/proc"):
                if entry.isdigit():
                    cmdline_p = os.path.join("/proc", entry, "cmdline")
                    if os.path.exists(cmdline_p):
                        with open(cmdline_p, "rb") as f:
                            content = f.read().replace(b"\x00", b" ").decode("utf-8", errors="ignore").lower()
                            if "workbuddy" in content and "workbuddy-log-guard" not in content and "python" not in content:
                                return True
            return False
        except Exception:
            pass
        try:
            res = subprocess.run(["pgrep", "-f", "-i", "workbuddy"],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5, close_fds=True)
            return bool(res.stdout.strip())
        except Exception:
            return False

DEFAULT_PROTECTED_KEYWORDS = ["zhihu", "zhihugrabber", "cargo", "rustc", "gcc", "clang", "ninja", "make",
                              "python", "node", "npm", "vite", "webpack", "go", "pytest"]

# Toolkit 自己的常驻/定时进程（router、log-guard、CLI）不算用户工作负载
TOOLKIT_PROCESS_NAMES = {"router_engine", "workbuddy", "workbuddy-log-guard", "credit_meter", "models_inventory",
                         "interactive_tool"}

_VERSION_SUFFIX = re.compile(r"[\d.]+$")

def _program_names(cmd):
    """取命令行前两个 token 的程序名（去目录、去扩展名、去版本号后缀）。

    第二个 token 用于识别解释器启动的脚本（`python3 train.py` -> python / train）。
    只比较完整程序名，避免旧版子串匹配的误判：
    "go" 命中 "Google Chrome"、"node" 命中任意 Electron Helper、"python" 命中 Toolkit 自己的 router。
    """
    names = []
    for tok in cmd.split()[:2]:
        base = os.path.basename(tok).lower()
        stem = os.path.splitext(base)[0] if base.endswith((".py", ".js", ".mjs", ".cjs", ".sh")) else base
        names.append(_VERSION_SUFFIX.sub("", stem) or stem)
    return names

def _is_toolkit_process(cmd):
    for tok in cmd.split()[:3]:
        base = os.path.basename(tok).lower()
        stem = os.path.splitext(base)[0]
        if stem in TOOLKIT_PROCESS_NAMES or base.startswith("wb-"):
            return True
    return False

def _is_protected_workload(cmd, protected_keywords):
    cmd_lower = cmd.lower()
    if "sandbox" in cmd_lower or _is_toolkit_process(cmd):
        return False
    names = _program_names(cmd)
    keywords = {kw.lower() for kw in protected_keywords}
    return any(n in keywords for n in names)

def reap_orphaned_daemons(protected_keywords=None, proc_list=None, lock_dir="/tmp"):
    """
    Reaps orphaned sandbox-center, sandbox-cli-gc, and codebuddy daemons
    ONLY IF WorkBuddy GUI is closed AND no protected user workloads or active sandbox sessions are running.
    """
    if protected_keywords is None:
        protected_keywords = DEFAULT_PROTECTED_KEYWORDS

    if is_workbuddy_gui_running():
        return {"reaped": False, "reason": "gui_running"}

    if proc_list is None:
        proc_list = _list_processes()
        if proc_list is None:
            return {"reaped": False, "reason": "ps_failed"}

    return _reap_from_process_list(proc_list, protected_keywords, lock_dir=lock_dir)

def _list_processes():
    """返回 [(pid, cmdline)]；失败返回 None。"""
    proc_list = []
    # Try zero-fork on Darwin via sysctl KERN_PROCARGS2 + libproc
    if sys.platform == "darwin":
        try:
            import ctypes
            libc = ctypes.CDLL(None)
            libproc = ctypes.CDLL("libproc.dylib")
            CTL_KERN = 1
            KERN_PROCARGS2 = 49
            needed = libproc.proc_listpids(1, 0, None, 0)
            num_slots = max(2048, (needed // ctypes.sizeof(ctypes.c_int)) + 128) if needed > 0 else 2048
            pids = (ctypes.c_int * num_slots)()
            bytes_ret = libproc.proc_listpids(1, 0, pids, ctypes.sizeof(pids))
            num_pids = bytes_ret // ctypes.sizeof(ctypes.c_int)
            size = ctypes.c_size_t(0)
            for i in range(num_pids):
                pid = pids[i]
                if pid <= 0:
                    continue
                mib = (ctypes.c_int * 3)(CTL_KERN, KERN_PROCARGS2, pid)
                size.value = 0
                ret = libc.sysctl(mib, 3, None, ctypes.byref(size), None, 0)
                if ret != 0 or size.value == 0:
                    continue
                buf = ctypes.create_string_buffer(size.value)
                ret = libc.sysctl(mib, 3, buf, ctypes.byref(size), None, 0)
                if ret != 0:
                    continue
                raw = buf.raw
                if len(raw) < 4:
                    continue
                argc = int.from_bytes(raw[:4], byteorder="little")
                pos = 4
                null_pos = raw.find(b"\x00", pos)
                if null_pos == -1:
                    continue
                pos = null_pos
                while pos < len(raw) and raw[pos] == 0:
                    pos += 1
                args = []
                for _ in range(min(argc, 64)):
                    next_null = raw.find(b"\x00", pos)
                    if next_null == -1:
                        break
                    args.append(raw[pos:next_null].decode("utf-8", errors="ignore"))
                    pos = next_null + 1
                proc_list.append((pid, " ".join(args)))
        except Exception:
            proc_list = []

    if not proc_list:
        try:
            ps_out = subprocess.run(["ps", "-A", "-o", "pid,command"],
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=5, close_fds=True).stdout
            for line in ps_out.splitlines()[1:]:
                parts = line.strip().split(None, 1)
                if len(parts) >= 2:
                    try:
                        proc_list.append((int(parts[0]), parts[1]))
                    except ValueError:
                        pass
        except Exception:
            return None
    return proc_list

def _reap_from_process_list(proc_list, protected_keywords, lock_dir="/tmp"):
    daemon_pids = []
    has_protected_task = False
    has_active_sandbox_cli = False
    excluded = {os.getpid()}
    if hasattr(os, "getppid"):
        excluded.add(os.getppid())

    for pid, cmd in proc_list:
        if pid in excluded:
            continue

        # Check for user-protected tasks (exact program-name match, toolkit processes excluded)
        if not has_protected_task and _is_protected_workload(cmd, protected_keywords):
            has_protected_task = True

        if "sandbox-cli " in cmd or cmd.endswith("sandbox-cli"):
            has_active_sandbox_cli = True

        if "sandbox-center" in cmd or "sandbox-cli-gc" in cmd or ("codebuddy" in cmd and "--prewarm" in cmd):
            daemon_pids.append(pid)

    if has_protected_task:
        return {"reaped": False, "reason": "user_workload_active"}
    if has_active_sandbox_cli:
        return {"reaped": False, "reason": "sandbox_cli_active"}

    reaped_pids = []
    for pid in daemon_pids:
        try:
            os.kill(pid, 15)  # SIGTERM
            reaped_pids.append(pid)
        except OSError:
            pass

    # Clean up lockfiles if all daemons stopped
    if reaped_pids:
        time.sleep(0.5)
        for lock_name in ["workbuddy-sandbox-center", "workbuddy-sandbox-cli-gc"]:
            try:
                tmp_entries = os.listdir(lock_dir)
            except OSError:
                tmp_entries = []
            for f in tmp_entries:
                if f.startswith(lock_name) and f.endswith(".lock"):
                    try:
                        os.remove(os.path.join(lock_dir, f))
                    except Exception:
                        pass

    return {"reaped": len(reaped_pids) > 0, "pids": reaped_pids}

def main():
    config = load_config()
    ttl_seconds = config["ttl_minutes"] * 60
    max_file_bytes = config["max_file_mb"] * 1024 * 1024
    max_sandbox_bytes = config["max_sandbox_mb"] * 1024 * 1024
    target_sandbox_bytes = config["target_sandbox_mb"] * 1024 * 1024
    now = time.time()
    today_str = datetime.now().strftime("%Y%m%d")

    open_files = get_open_files(LOG_DIR)
    if os.path.exists(SESSIONS_DIR):
        open_files.update(get_open_files(SESSIONS_DIR))

    # 1. Truncate over-sized files (even if not open)
    if os.path.exists(LOG_DIR):
        for dirpath, _, filenames in os.walk(LOG_DIR):
            for f in filenames:
                fp = os.path.join(dirpath, f)
                try:
                    if os.path.getsize(fp) > max_file_bytes:
                        truncate_file(fp)
                except Exception:
                    pass

    # 2. TTL Cleanup for sandbox
    if os.path.exists(SANDBOX_DIR):
        for dirpath, _dirnames, filenames in os.walk(SANDBOX_DIR):
            dir_basename = os.path.basename(dirpath)
            for f in filenames:
                fp = os.path.join(dirpath, f)
                try:
                    mtime = os.path.getmtime(fp)
                    if now - mtime > ttl_seconds:
                        if is_file_open(fp, open_files):
                            if os.name != 'nt':
                                truncate_file(fp)
                        elif dir_basename != today_str and dir_basename != "sandbox":
                            remove_file(fp)
                except Exception:
                    pass
        
        # 3. Directory capacity hard limit
        current_size = get_dir_size(SANDBOX_DIR)
        if current_size > max_sandbox_bytes:
            # Collect files, sort by mtime
            all_files = []
            for dirpath, _, filenames in os.walk(SANDBOX_DIR):
                dir_basename = os.path.basename(dirpath)
                for f in filenames:
                    fp = os.path.join(dirpath, f)
                    try:
                        all_files.append((os.path.getmtime(fp), fp, dir_basename))
                    except Exception:
                        pass
            all_files.sort(key=lambda x: x[0])
            
            for _mtime, fp, dir_basename in all_files:
                if current_size <= target_sandbox_bytes:
                    break
                try:
                    size = os.path.getsize(fp)
                    if is_file_open(fp, open_files):
                        if os.name != 'nt':
                            if truncate_file(fp):
                                current_size -= size
                    elif dir_basename != today_str and dir_basename != "sandbox":
                        if remove_file(fp):
                            current_size -= size
                except Exception:
                    pass

    # 4. Other log dir cleanup
    if os.path.exists(LOG_DIR):
        for dirpath, _dirnames, filenames in os.walk(LOG_DIR, topdown=False):
            # Skip root log dir and sandbox dir correctly
            if dirpath == LOG_DIR or dirpath.startswith(os.path.join(SANDBOX_DIR, "")) or dirpath == SANDBOX_DIR:
                continue
            for f in filenames:
                fp = os.path.join(dirpath, f)
                try:
                    if now - os.path.getmtime(fp) > ttl_seconds:
                        if is_file_open(fp, open_files):
                            if os.name != 'nt':
                                truncate_file(fp)
                        else:
                            remove_file(fp)
                except Exception:
                    pass
            # Clean empty directories (bottom-up traversal makes this work properly)
            if not os.listdir(dirpath):
                try:
                    os.rmdir(dirpath)
                except Exception:
                    pass

    # 5. Clean traces directory (24 hours TTL)
    traces_ttl = 24 * 3600
    if os.path.exists(TRACES_DIR):
        for dirpath, _dirnames, filenames in os.walk(TRACES_DIR, topdown=False):
            for f in filenames:
                fp = os.path.join(dirpath, f)
                try:
                    if now - os.path.getmtime(fp) > traces_ttl:
                        remove_file(fp)
                except Exception:
                    pass
            if dirpath != TRACES_DIR and not os.listdir(dirpath):
                try:
                    os.rmdir(dirpath)
                except Exception:
                    pass

    # 6. Clean WorkBuddy session snapshots and modify backups (default TTL: 72h / 3 days)
    sessions_ttl = config.get("sessions_ttl_hours", 72)
    max_sessions = config.get("max_sessions_keep", 10)
    clean_session_snapshots(SESSIONS_DIR, open_files, ttl_hours=sessions_ttl, max_keep=max_sessions)

    # 7. Clean shell snapshots
    clean_shell_snapshots(SHELL_SNAPSHOTS_DIR, ttl_hours=sessions_ttl)

    # 8. Auto-heal Seatbelt rules in live sandbox-center
    if config.get("heal_seatbelt_rules", True):
        try:
            heal_sandbox_center_rules()
        except Exception:
            pass

    # 9. Reap orphaned sandbox daemons if GUI is closed
    if config.get("reap_orphaned_daemons", True):
        try:
            reap_orphaned_daemons()
        except Exception:
            pass

    # 10. Clean runaway temp logs (default cap: 500MB, only files still being written)
    if config.get("clean_runaway_temp_logs", True):
        try:
            max_temp_mb = config.get("max_temp_file_mb", 500)
            clean_runaway_temp_logs(max_temp_file_mb=max_temp_mb)
        except Exception:
            pass

    # 11. Clean stale WorkBuddy bundle migration update caches (>72h)
    try:
        bm_ttl = config.get("bundle_migration_ttl_hours", 72)
        clean_bundle_migration_cache(ttl_hours=bm_ttl)
    except Exception:
        pass

if __name__ == "__main__":
    main()

